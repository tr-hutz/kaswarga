# Copy this file to .env.local and fill in the values.
# Find all values in your Supabase project settings.

# -----------------------------------------------------------------------
# Supabase — required for all environments
# -----------------------------------------------------------------------

# Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / publishable key — safe to embed in client bundles
# (Settings → API → Project API keys → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Service-role key — SERVER ONLY, never expose to the client
# (Settings → API → Project API keys → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# -----------------------------------------------------------------------
# App
# -----------------------------------------------------------------------

# Fully-qualified public URL of your site — used in invite email links
# Leave as http://localhost:3000 for local development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
